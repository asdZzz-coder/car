<Window x:Class="car.VehicleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- 新增 / 編輯車輛：名稱（必填）與車牌（選填） -->
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="車輛名稱 *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" ToolTip="例如：白色 Altis、老婆的車"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock Text="車牌" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
        <TextBox x:Name="PlateBox" ToolTip="選填，例如 ABC-1234"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button IsCancel="True" MinWidth="88" Margin="0,0,8,0" Content="取消"/>
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88"
                    Content="確定" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
