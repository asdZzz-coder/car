<Window x:Class="car.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="車輛紀錄" Height="840" Width="1260" MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 卡片：白底、細框、大圓角；陰影放在另一層（見 CardShadow），避免內文被模糊 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.07" Color="#1E1B4B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 統計小卡：標題、數字、說明 -->
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="StatHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 表單下方的說明文字 -->
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,6,0,0"/>
        </Style>

        <!-- 清單左側的日期方塊（月/日 + 年） -->
        <DataTemplate x:Key="DateBlock">
            <Border Width="54" Height="50" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Day}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Year}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 加油清單：日期、加了多少 / 花多少、里程與單價；右邊是這段的油耗與開了幾公里 -->
        <DataTemplate x:Key="FuelTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DateBlock}"/>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="120">
                    <Border x:Name="EcoBadge" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right"
                            Background="{DynamicResource AccentSoftBrush}" ToolTip="這次加滿開到下次加滿的平均油耗">
                        <TextBlock x:Name="EcoText" Text="{Binding Economy}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Distance}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" Margin="0,4,2,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasEconomy}" Value="False">
                    <Setter TargetName="EcoBadge" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="EcoText" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    <Setter TargetName="EcoText" Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 保養清單：日期、保養項目、里程與保養廠；右邊是金額 -->
        <DataTemplate x:Key="MaintenanceTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DateBlock}"/>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding AmountText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 空清單提示：清單沒有項目時才顯示 -->
        <Style x:Key="EmptyHint" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題列 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <!-- 工具列：一條白色膠囊裡放幾個透明按鈕 -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- 主題：按一下依序切換 跟隨系統 → 淺色 → 深色（圖示與提示文字由程式設定） -->
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Padding="10,8" Click="Theme_Click">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;"/>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯出 Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯入 Excel"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="在桌面建立（或修復）車輛紀錄的捷徑" Click="Shortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="桌面捷徑"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="檢查更新"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#4F46E5"/>
                </Border.Effect>
                <TextBlock Text="&#xE804;" Style="{StaticResource Icon}" FontSize="22" Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="車輛紀錄" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 分頁：加油 / 保養 ===== -->
        <Border Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="4" CornerRadius="13"
                Background="{DynamicResource PressedBrush}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FuelTab" Style="{StaticResource TabToggle}" GroupName="Tabs" IsChecked="True" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE804;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="加油紀錄"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MaintenanceTab" Style="{StaticResource TabToggle}" GroupName="Tabs" Margin="4,0,0,0" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="保養紀錄"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ===== 加油 ===== -->
        <Grid x:Name="FuelPanel" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 統計 -->
                <UniformGrid Columns="4" Margin="0,0,-12,16">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="平均油耗" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="AvgEconomyText" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="AvgEconomyHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="加油總花費" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="FuelTotalText" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="FuelTotalHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="總加油量" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="LitersTotalText" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="LitersTotalHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="每公里油錢" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="CostPerKmText" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="CostPerKmHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 清單 -->
                <Border Grid.Row="1" Style="{StaticResource CardShadow}"/>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,16,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="6,0,8,12">
                            <TextBlock DockPanel.Dock="Right" Text="依里程排序，最新的在最上面" FontSize="12"
                                       Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="加油紀錄" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                        </DockPanel>
                        <ListBox x:Name="FuelList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                                 ItemTemplate="{StaticResource FuelTemplate}" SelectionMode="Single"
                                 SelectionChanged="FuelList_SelectionChanged"/>
                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyHint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=FuelList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="&#xE804;" Style="{StaticResource Icon}" FontSize="26"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock TextAlignment="Center" LineHeight="20" Foreground="{DynamicResource MutedBrush}"
                                       Text="還沒有加油紀錄&#x0a;從右邊新增第一筆吧"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 表單 -->
            <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,20,20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                ToolTip="清空表單，準備新增一筆" Click="FuelClear_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="清空"/>
                            </StackPanel>
                        </Button>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="FuelFormTitle" Text="新增加油" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="日期 *" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <TextBox x:Name="FuelDateBox" Padding="12,8,44,8" ToolTip="例如 2026/10/06"/>
                                <Button Content="&#xE787;" Style="{StaticResource FieldIconButton}" HorizontalAlignment="Right"
                                        Margin="0,0,4,0" ToolTip="設成今天" Click="FuelToday_Click"/>
                            </Grid>

                            <TextBlock Text="里程表 (公里) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FuelOdoBox" Margin="0,0,0,14" ToolTip="加油時里程表上的總公里數"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="加油量 (公升) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FuelLitersBox" TextChanged="FuelPrice_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="金額 (元) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FuelAmountBox" TextChanged="FuelPrice_TextChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UnitPriceText" Style="{StaticResource FieldHint}" Margin="2,6,0,14"
                                       Text="填好加油量與金額會自動算出單價"/>

                            <CheckBox x:Name="FuelFullBox" Content="這次有加滿" IsChecked="True"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="30,4,0,14"
                                       Text="油耗用加滿法計算：加滿 → 開到下次加滿，用下次加的油量算。沒加滿的那次會併到下次加滿一起算。"/>

                            <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FuelNoteBox" Margin="0,0,0,14" Height="64" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <!-- 選取紀錄時顯示這一筆算出來的結果 -->
                            <Border x:Name="FuelInfo" CornerRadius="12" Padding="14,12" Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="FuelInfoText" TextWrapping="Wrap" LineHeight="21" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 操作按鈕固定在卡片底部，表單再長也不會被捲出畫面 -->
                    <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,16,0,0">
                        <Button x:Name="FuelAddButton" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,10" Click="FuelAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="新增"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="5,0,5,0" Padding="10,10" Click="FuelSave_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="儲存修改"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Margin="5,0,0,0" Padding="10,10" Click="FuelDelete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="刪除"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 保養 ===== -->
        <Grid x:Name="MaintenancePanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Columns="4" Margin="0,0,-12,16">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="保養總花費" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="MaintTotalText" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="MaintTotalHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="上次保養" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="LastMaintText" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="LastMaintHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="距上次保養" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="SinceMaintText" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="SinceMaintHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="下次保養" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="NextMaintText" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="NextMaintHint" Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource CardShadow}"/>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,16,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="6,0,8,12">
                            <TextBlock DockPanel.Dock="Right" Text="依里程排序，最新的在最上面" FontSize="12"
                                       Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="保養紀錄" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                        </DockPanel>
                        <ListBox x:Name="MaintenanceList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                                 ItemTemplate="{StaticResource MaintenanceTemplate}" SelectionMode="Single"
                                 SelectionChanged="MaintenanceList_SelectionChanged"/>
                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyHint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=MaintenanceList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="26"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock TextAlignment="Center" LineHeight="20" Foreground="{DynamicResource MutedBrush}"
                                       Text="還沒有保養紀錄&#x0a;從右邊新增第一筆吧"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,20,20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                ToolTip="清空表單，準備新增一筆" Click="MaintClear_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="清空"/>
                            </StackPanel>
                        </Button>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="MaintFormTitle" Text="新增保養" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="日期 *" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <TextBox x:Name="MaintDateBox" Padding="12,8,44,8" ToolTip="例如 2026/10/06"/>
                                        <Button Content="&#xE787;" Style="{StaticResource FieldIconButton}" HorizontalAlignment="Right"
                                                Margin="0,0,4,0" ToolTip="設成今天" Click="MaintToday_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="里程 (公里) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MaintOdoBox" ToolTip="保養時里程表上的總公里數"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="保養項目 *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MaintItemsBox" Margin="0,0,0,14" Height="64" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     ToolTip="例如：機油、機油芯、空氣濾網"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="金額 (元) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MaintAmountBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="保養廠" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MaintShopBox"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="下次保養里程 (公里)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MaintNextBox" ToolTip="選填；填了會在上方顯示還剩幾公里要保養"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                                <TextBlock Text="快速填入：" Style="{StaticResource FieldHint}" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                <Button Content="+5,000" Tag="5000" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                                        ToolTip="這次里程再加 5,000 公里" Click="NextQuick_Click"/>
                                <Button Content="+10,000" Tag="10000" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                                        ToolTip="這次里程再加 10,000 公里" Click="NextQuick_Click"/>
                            </StackPanel>

                            <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MaintNoteBox" Height="64" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>

                    <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,10" Click="MaintAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="新增"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="5,0,5,0" Padding="10,10" Click="MaintSave_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="儲存修改"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Margin="5,0,0,0" Padding="10,10" Click="MaintDelete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="刪除"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 頁尾 ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,12,0,0">
            <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
